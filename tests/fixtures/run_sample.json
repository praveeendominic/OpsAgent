      ],
      "root_cause": {
        "summary": "The orders-api process keeps a per-order cache that is never evicted, so resident memory grows linearly at about 240 MB per minute until the 2 GB t3.small is exhausted and the kernel kills the process. systemd restarts it, which clears memory but restarts the leak.",
        "category": "application_memory_leak",
        "contributing": [
          "orders-api.service has no MemoryMax or MemoryHigh, so the kernel OOM killer rather than systemd handles the exhaustion",
          "t3.small has 2 GB RAM and no swap; the headroom is consumed in six minutes"
        ],
        "confidence": "high"
      },
      "citations": [
        {"title": "systemd.resource-control: MemoryMax and MemoryHigh", "source": "kb://docs/systemd-resource-control.md#memorymax", "snippet": "MemoryHigh throttles the unit before MemoryMax terminates it, giving the application a chance to shed memory."},
        {"title": "Amazon EC2 memory metrics with the CloudWatch agent", "source": "https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/metrics-collected-by-CloudWatch-agent.html", "snippet": "mem_available_percent is the percentage of memory that is available for starting new applications without swapping."},
        {"title": "Closed incident inc-20261102-cache-leak (orders-api, accepted)", "source": "kb://incidents/inc-20261102-091533-oom-9ad22c", "snippet": "Same cgroup, same growth pattern; the durable fix was a bounded LRU on the order cache."}
      ],
      "fixes": [
        {
          "horizon": "immediate",
          "owner": "ops",
          "action": "set_unit_memory_limits",
          "detail": "Put a systemd drop-in on orders-api.service so the unit is throttled at 1.2 GB and restarted cleanly at 1.5 GB instead of being hit by the kernel OOM killer.",
          "command": "sudo systemctl set-property orders-api.service MemoryHigh=1200M MemoryMax=1500M\nsudo systemctl daemon-reload && sudo systemctl restart orders-api.service",
          "reversal": "sudo systemctl revert orders-api.service && sudo systemctl restart orders-api.service"
        },
        {
          "horizon": "durable",
          "owner": "dev",
          "action": "bound_cache",
          "detail": "Replace the unbounded dict in the order cache with a size-bounded LRU (for example cachetools.LRUCache(maxsize=10000)) and add an eviction metric.",
          "command": null,
          "reversal": null
        }
      ],
      "classification_agreement": "agreed",
      "notes": "A resize to t3.medium would only delay the kill by about four minutes and is not recommended.",
      "created_at": "2026-11-15T15:25:02.980+00:00"
    },
