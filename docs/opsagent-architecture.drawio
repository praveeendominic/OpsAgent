<mxfile host="app.diagrams.net" modified="2026-11-15T23:10:43Z" agent="OpsAgent design generator" version="24.7.0" type="device" pages="4"><diagram id="arch" name="1. Architecture (AWS PoC)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1039" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arch-2" value="OpsAgent: one Flow, six crews, from alarm to an approved fix in under five minutes" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1100" height="32" as="geometry"/></mxCell><mxCell id="arch-3" value="&lt;font color=&quot;#5F6B7A&quot;&gt;Orange outline = the only components that can change infrastructure, used after a human approval. Only the CloudWatch agent, metrics, logs and alarms exist today; everything from the enricher down is proposed.&lt;/font&gt;" style="text;html=1;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontColor=#1F2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1100" height="20" as="geometry"/></mxCell><mxCell id="arch-4" value="EVENT CAPTURE  ·  native AWS signals, plus the OpsAgent enricher" style="swimlane;rounded=1;arcSize=5;startSize=32;html=1;fontStyle=1;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;align=left;spacingLeft=12;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1100" height="125" as="geometry"/></mxCell><mxCell id="arch-5" value="&lt;b&gt;EC2 instance&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;CloudWatch agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#607D8B;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-4"><mxGeometry x="20.0" y="45" width="250.0" height="64" as="geometry"/></mxCell><mxCell id="arch-6" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;metrics and logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#607D8B;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-4"><mxGeometry x="290.0" y="45" width="250.0" height="64" as="geometry"/></mxCell><mxCell id="arch-7" value="&lt;b&gt;Alarm&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;EventBridge rule&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#607D8B;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-4"><mxGeometry x="560.0" y="45" width="250.0" height="64" as="geometry"/></mxCell><mxCell id="arch-8" value="&lt;b&gt;Lambda enricher&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;15 min evidence window&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#607D8B;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-4"><mxGeometry x="830.0" y="45" width="250.0" height="64" as="geometry"/></mxCell><mxCell id="arch-9" value="INGESTION  ·  durable hand-off into the Flow" style="swimlane;rounded=1;arcSize=5;startSize=32;html=1;fontStyle=1;fontSize=13;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;align=left;spacingLeft=12;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="235" width="1100" height="125" as="geometry"/></mxCell><mxCell id="arch-10" value="&lt;b&gt;SQS FIFO queue&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;dedupe on event_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#1E88E5;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-9"><mxGeometry x="20.0" y="45" width="250.0" height="64" as="geometry"/></mxCell><mxCell id="arch-11" value="&lt;b&gt;Flow intake&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;validate, parse, classify&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#1E88E5;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-9"><mxGeometry x="290.0" y="45" width="250.0" height="64" as="geometry"/></mxCell><mxCell id="arch-12" value="&lt;b&gt;Flow state&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Postgres, resumable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#1E88E5;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-9"><mxGeometry x="560.0" y="45" width="250.0" height="64" as="geometry"/></mxCell><mxCell id="arch-13" value="&lt;b&gt;Watchdog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;delay notice at 5 min&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#1E88E5;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-9"><mxGeometry x="830.0" y="45" width="250.0" height="64" as="geometry"/></mxCell><mxCell id="arch-14" value="CREWAI INCIDENTFLOW  ·  one persisted state, six crews" style="swimlane;rounded=1;arcSize=5;startSize=32;html=1;fontStyle=1;fontSize=13;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;align=left;spacingLeft=12;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="1100" height="249" as="geometry"/></mxCell><mxCell id="arch-15" value="&lt;b&gt;Triage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Parse, classify by rule, severity&lt;br&gt;writes triage-1.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-14"><mxGeometry x="20.0" y="45" width="340.0" height="86" as="geometry"/></mxCell><mxCell id="arch-16" value="&lt;b&gt;Diagnostics&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;RCA with citations from KB&lt;br&gt;ranks immediate, durable fixes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-14"><mxGeometry x="380.0" y="45" width="340.0" height="86" as="geometry"/></mxCell><mxCell id="arch-17" value="&lt;b&gt;Code Correlation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Repo path behind the log line&lt;br&gt;verdict: code, infra, shared&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-14"><mxGeometry x="740.0" y="45" width="340.0" height="86" as="geometry"/></mxCell><mxCell id="arch-18" value="&lt;b&gt;Incident Bridge&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Stage 1 at T+60 s, stage 2 RCA&lt;br&gt;Teams, email, xMatters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-14"><mxGeometry x="20.0" y="147" width="340.0" height="86" as="geometry"/></mxCell><mxCell id="arch-19" value="&lt;b&gt;Self-Healing&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Catalog action, dry-run&lt;br&gt;approve, verify, roll back&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#1F2933;strokeWidth=2.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-14"><mxGeometry x="380.0" y="147" width="340.0" height="86" as="geometry"/></mxCell><mxCell id="arch-20" value="&lt;b&gt;Knowledge&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Docs refresh on cadence&lt;br&gt;incident write-back, label&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-14"><mxGeometry x="740.0" y="147" width="340.0" height="86" as="geometry"/></mxCell><mxCell id="arch-21" value="ACTIONS AND NOTIFICATIONS" style="swimlane;rounded=1;arcSize=5;startSize=32;html=1;fontStyle=1;fontSize=13;fillColor=#F3E5F5;strokeColor=#8E24AA;fontColor=#4A148C;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;align=left;spacingLeft=12;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="689" width="1100" height="125" as="geometry"/></mxCell><mxCell id="arch-22" value="&lt;b&gt;Teams&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;adaptive card&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#8E24AA;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-21"><mxGeometry x="20.0" y="45" width="196.0" height="64" as="geometry"/></mxCell><mxCell id="arch-23" value="&lt;b&gt;Email&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;SMTP relay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#8E24AA;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-21"><mxGeometry x="236.0" y="45" width="196.0" height="64" as="geometry"/></mxCell><mxCell id="arch-24" value="&lt;b&gt;xMatters&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;voice page&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#8E24AA;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-21"><mxGeometry x="452.0" y="45" width="196.0" height="64" as="geometry"/></mxCell><mxCell id="arch-25" value="&lt;b&gt;SSM + boto3&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;approved only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#1F2933;strokeWidth=2.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-21"><mxGeometry x="668.0" y="45" width="196.0" height="64" as="geometry"/></mxCell><mxCell id="arch-26" value="&lt;b&gt;Terraform PR&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;durable change&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#8E24AA;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-21"><mxGeometry x="884.0" y="45" width="196.0" height="64" as="geometry"/></mxCell><mxCell id="arch-27" value="FOUNDATION  ·  read-only tools, model and tracing used by every crew" style="swimlane;rounded=1;arcSize=5;startSize=32;html=1;fontStyle=1;fontSize=13;fillColor=#FFF8E1;strokeColor=#FFB300;fontColor=#E65100;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;align=left;spacingLeft=12;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="854" width="1100" height="125" as="geometry"/></mxCell><mxCell id="arch-28" value="&lt;b&gt;Vector store&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Chroma, pgvector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#FFB300;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-27"><mxGeometry x="20.0" y="45" width="196.0" height="64" as="geometry"/></mxCell><mxCell id="arch-29" value="&lt;b&gt;AWS Docs MCP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;live documentation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#FFB300;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-27"><mxGeometry x="236.0" y="45" width="196.0" height="64" as="geometry"/></mxCell><mxCell id="arch-30" value="&lt;b&gt;GitHub MCP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;read-only repo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#FFB300;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-27"><mxGeometry x="452.0" y="45" width="196.0" height="64" as="geometry"/></mxCell><mxCell id="arch-31" value="&lt;b&gt;Azure OpenAI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;gpt-4o&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#FFB300;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-27"><mxGeometry x="668.0" y="45" width="196.0" height="64" as="geometry"/></mxCell><mxCell id="arch-32" value="&lt;b&gt;Langfuse&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;traces, cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#FFB300;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="arch-27"><mxGeometry x="884.0" y="45" width="196.0" height="64" as="geometry"/></mxCell><mxCell id="arch-33" value="raw-1.0 event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6B7A;strokeWidth=1.5;fontSize=11;fontColor=#5F6B7A;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;verticalAlign=middle;align=left;spacingLeft=8;" edge="1" parent="1" source="arch-4" target="arch-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-34" value="kickoff_async(event)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6B7A;strokeWidth=1.5;fontSize=11;fontColor=#5F6B7A;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;verticalAlign=middle;align=left;spacingLeft=8;" edge="1" parent="1" source="arch-9" target="arch-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-35" value="notify;  remediate only after approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6B7A;strokeWidth=1.5;fontSize=11;fontColor=#5F6B7A;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;verticalAlign=middle;align=left;spacingLeft=8;" edge="1" parent="1" source="arch-14" target="arch-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="2. CrewAI IncidentFlow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow-2" value="IncidentFlow: critical events fan out to three crews; only remediation waits for a person" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1100" height="32" as="geometry"/></mxCell><mxCell id="flow-3" value="&lt;b&gt;intake  @start&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;raw-1.0 or classified-1.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="435.0" y="64.0" width="270" height="72" as="geometry"/></mxCell><mxCell id="flow-4" value="&lt;b&gt;watchdog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;delay notice at T+5 min&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="780.0" y="169.0" width="270" height="72" as="geometry"/></mxCell><mxCell id="flow-5" value="&lt;b&gt;triage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Triage crew  →  triage-1.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="435.0" y="169.0" width="270" height="72" as="geometry"/></mxCell><mxCell id="flow-6" value="@router  severity?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1F2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="465" y="283" width="210" height="84" as="geometry"/></mxCell><mxCell id="flow-7" value="&lt;b&gt;log or warn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;info logs, warning notes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90.0" y="289.0" width="270" height="72" as="geometry"/></mxCell><mxCell id="flow-8" value="&lt;b&gt;page_stage1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Incident Bridge, T+60 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90.0" y="424.0" width="270" height="72" as="geometry"/></mxCell><mxCell id="flow-9" value="&lt;b&gt;diagnose&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Diagnostics crew&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="435.0" y="424.0" width="270" height="72" as="geometry"/></mxCell><mxCell id="flow-10" value="&lt;b&gt;correlate_code&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Code Correlation crew&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#43A047;fontColor=#1F2933;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780.0" y="424.0" width="270" height="72" as="geometry"/></mxCell><mxCell id="flow-11" value="&lt;b&gt;plan_remediation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Self-Healing planner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#1F2933;strok