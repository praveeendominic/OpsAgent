# OpsAgent local configuration (gitignored). Fill the blanks; never commit this file.
AZURE_API_KEY=
AZURE_API_BASE=https://ark-llm-rg.openai.azure.com
AZURE_API_VERSION=2024-10-21
AZURE_DEPLOYMENT=gpt-4o
# Notifications (leave empty to write to outbox/ instead)
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# ServiceNow ITSM (leave empty to skip; stage 1 opens the incident, stage 2 and closure add work notes)
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SERVICENOW_TOKEN=
SERVICENOW_ASSIGNMENT_GROUP=
SERVICENOW_CALLER_ID=
SERVICENOW_CATEGORY=software
SERVICENOW_RESOLVE_ON_CLOSE=0

# xMatters heads-up call: one event at stage 1 rings on-call with a short spoken message; the close step terminates
# it. Trigger URL: the instance's stock Send Alert form, https://<company>.xmatters.com/api/xm/1/forms/<form id>/triggers
# (form id from GET /api/xm/1/forms), or a Flow Designer trigger. User/password: the xMatters web login (email) of a
# user with the REST Web Service User role, or an API key id and secret. Recipients: comma-separated group or user
# names; empty means the form's own recipients. Devices: which of the recipients' devices to ring; empty = all of them,
# email included. The free plan has email and the xMatters mobile app only (device names "Android Phone" / "iPhone",
# registered when the person signs in to the app); voice and SMS devices ("Mobile Phone", "Work Phone", "SMS Phone")
# need a paid plan.
XMATTERS_TRIGGER_URL=
XMATTERS_USER=
XMATTERS_PASSWORD=
XMATTERS_RECIPIENTS=
XMATTERS_DEVICES=Android Phone,iPhone,Mobile Phone,Work Phone
# The Send Alert form carries only Summary and Message (a custom form with OpsAgent's property names leaves this empty):
XMATTERS_PROPERTIES=summary=Summary,details=Message
XMATTERS_TERMINATE_ON_CLOSE=1

# Severity policy (thresholds, severity rules, ServiceNow impact/urgency, xMatters priority, paging). Versioned YAML.
OPSAGENT_SEVERITY_POLICY=config/severity.yaml
# Optional integrations
AWS_DOCS_MCP=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Feature flags
OPSAGENT_SELF_HEALING=0
