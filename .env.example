# OpsAgent local configuration (gitignored). Fill the blanks; never commit this file.
AZURE_API_KEY=
AZURE_API_BASE=https://ark-llm-rg.openai.azure.com
AZURE_API_VERSION=2024-10-21
AZURE_DEPLOYMENT=gpt-4o
# Notifications (leave empty to write to outbox/ instead)
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# ServiceNow ITSM (leave empty to skip; stage 1 opens the incident, stage 2 and closure add work notes)
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SERVICENOW_TOKEN=
SERVICENOW_ASSIGNMENT_GROUP=
SERVICENOW_CALLER_ID=
SERVICENOW_CATEGORY=software
SERVICENOW_RESOLVE_ON_CLOSE=0

# xMatters on-call paging. The trigger URL comes from a workflow in Flow Designer (HTTP trigger, or a Create Event
# form's inbound integration URL). User/password: a REST Web Service user, or an API key id and secret; they unlock
# annotations on the event at stage 2 / delay / closure and its termination on close. Recipients: comma-separated
# xMatters target names (groups or users); empty means the form's own recipients.
XMATTERS_TRIGGER_URL=
XMATTERS_USER=
XMATTERS_PASSWORD=
XMATTERS_RECIPIENTS=
XMATTERS_TERMINATE_ON_CLOSE=1

# Severity policy (thresholds, severity rules, ServiceNow impact/urgency, xMatters priority, paging). Versioned YAML.
OPSAGENT_SEVERITY_POLICY=config/severity.yaml
# Optional integrations
AWS_DOCS_MCP=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Feature flags
OPSAGENT_SELF_HEALING=0
